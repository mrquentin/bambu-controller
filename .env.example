# Copy to .env (never commit .env).

# Encrypts printer access codes at rest. Generate with: openssl rand -base64 32
APP_SECRET=

# Set when the app is reached over HTTPS (reverse proxy or TLS_CERT_FILE/TLS_KEY_FILE).
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Contact for browser push services (notifications): mailto:you@example.com or an https URL.
# VAPID_SUBJECT=mailto:you@example.com
