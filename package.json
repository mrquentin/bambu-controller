{
  "name": "bambu-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight self-hosted web app to monitor and control Bambu Lab printers in LAN mode",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "check": "tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.web.json",
    "fake-printer": "node scripts/fake-printer.ts",
    "icons": "node scripts/build-icons.ts",
    "sbom": "npm sbom --sbom-format=cyclonedx --omit=dev > sbom.json",
    "audit": "npm audit --audit-level=high",
    "test": "node --import ./test/setup.ts --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "basic-ftp": "6.2.6",
    "fastify": "5.12.8",
    "mqtt": "5.16.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@semantic-release/exec": "7.1.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "24.19.2",
    "aedes": "1.2.0",
    "concurrently": "9.2.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "selfsigned": "5.5.0",
    "semantic-release": "25.0.9",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
