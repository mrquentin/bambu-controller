{
  "name": "bambu-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight self-hosted web app to monitor and control Bambu Lab printers in LAN mode",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "check": "tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.web.json",
    "fake-printer": "node scripts/fake-printer.ts",
    "icons": "node scripts/build-icons.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "basic-ftp": "^5.0.5",
    "fastify": "^5.4.0",
    "mqtt": "^5.13.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/node": "^24.0.0",
    "aedes": "^1.2.0",
    "concurrently": "^9.2.0",
    "selfsigned": "^5.5.0",
    "svelte": "^5.35.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
